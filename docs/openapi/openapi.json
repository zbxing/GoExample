{
  "openapi": "3.1.0",
  "info": {
    "title": "GoExample Example Fiber API",
    "version": "1.4.0",
    "summary": "Framework platform endpoints and the Example project API",
    "description": "The local password login operation is registered only when demo authentication is enabled. Protected API operations accept an enabled Bearer verifier or an opaque browser session established by OIDC; unsafe cookie-authenticated requests also require the bound CSRF header. Internal bearer protection for metrics is mandatory in production configuration."
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local Example server"
    }
  ],
  "tags": [
    { "name": "platform" },
    { "name": "health" },
    { "name": "auth" },
    { "name": "example" },
    { "name": "project" }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getServiceIndex",
        "tags": ["platform"],
        "summary": "Read service identity and advertised endpoints",
        "responses": {
          "200": {
            "description": "Service identity",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Envelope" }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "operationId": "getPrometheusMetrics",
        "tags": ["platform"],
        "summary": "Read Prometheus metrics",
        "security": [{ "internalBearer": [] }],
        "responses": {
          "200": {
            "description": "Prometheus text exposition",
            "content": {
              "text/plain": { "schema": { "type": "string" } }
            }
          },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" }
        }
      }
    },
    "/livez": {
      "get": {
        "operationId": "getLiveness",
        "tags": ["health"],
        "responses": { "200": { "$ref": "#/components/responses/Health" } }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "tags": ["health"],
        "responses": {
          "200": { "$ref": "#/components/responses/Health" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/startupz": {
      "get": {
        "operationId": "getStartup",
        "tags": ["health"],
        "responses": { "200": { "$ref": "#/components/responses/Health" } }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getApiLiveness",
        "tags": ["health"],
        "summary": "Deprecated compatibility alias for /livez",
        "deprecated": true,
        "externalDocs": {
          "description": "Health endpoint migration",
          "url": "./health-endpoint-migration.md"
        },
        "responses": { "200": { "$ref": "#/components/responses/DeprecatedHealth" } }
      }
    },
    "/api/health/ready": {
      "get": {
        "operationId": "getApiReadiness",
        "tags": ["health"],
        "summary": "Deprecated compatibility alias for /readyz",
        "deprecated": true,
        "externalDocs": {
          "description": "Health endpoint migration",
          "url": "./health-endpoint-migration.md"
        },
        "responses": {
          "200": { "$ref": "#/components/responses/DeprecatedHealth" },
          "503": { "$ref": "#/components/responses/DeprecatedUnavailable" }
        }
      }
    },
    "/api/health/startup": {
      "get": {
        "operationId": "getApiStartup",
        "tags": ["health"],
        "summary": "Deprecated compatibility alias for /startupz",
        "deprecated": true,
        "externalDocs": {
          "description": "Health endpoint migration",
          "url": "./health-endpoint-migration.md"
        },
        "responses": { "200": { "$ref": "#/components/responses/DeprecatedHealth" } }
      }
    },
    "/api/system/info": {
      "get": {
        "operationId": "getSystemInfo",
        "tags": ["platform"],
        "responses": {
          "200": {
            "description": "Build and runtime identity",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "tags": ["auth"],
        "summary": "Issue a demo bearer token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/auth/oidc/start": {
      "get": {
        "operationId": "startOIDCBrowserAuthorization",
        "tags": ["auth"],
        "summary": "Start browser OIDC Authorization Code + PKCE",
        "responses": {
          "302": {
            "description": "Redirect to the configured OIDC authorization endpoint with an HttpOnly state-binding cookie",
            "headers": {
              "Location": {
                "description": "Validated provider authorization URL",
                "schema": { "type": "string", "format": "uri" }
              },
              "Set-Cookie": {
                "description": "Secure, HttpOnly, SameSite=Lax state-binding cookie",
                "schema": { "type": "string" }
              }
            }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "operationId": "completeOIDCBrowserAuthorization",
        "tags": ["auth"],
        "summary": "Complete a state-cookie-bound browser OIDC callback",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "minLength": 1, "maxLength": 8192 }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "minLength": 1, "maxLength": 1024 }
          }
        ],
        "responses": {
          "204": {
            "description": "ID and access tokens were verified with the same bounded subject and an opaque application session was established; no provider token or callback value is returned",
            "headers": {
              "Set-Cookie": {
                "description": "Expires the one-time state-binding cookie and sets Secure __Host- session and CSRF cookies",
                "schema": { "type": "string" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/auth/oidc/logout": {
      "post": {
        "operationId": "logoutOIDCBrowserSession",
        "tags": ["auth"],
        "summary": "Revoke the current opaque browser session",
        "security": [{ "browserSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/BrowserCSRFToken" }],
        "responses": {
          "204": {
            "description": "Session revoked and session/CSRF cookies expired",
            "headers": {
              "Set-Cookie": {
                "description": "Expires the Secure __Host- session and CSRF cookies",
                "schema": { "type": "string" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/auth/oidc/sessions": {
      "get": {
        "operationId": "listOIDCBrowserSessions",
        "tags": ["auth"],
        "summary": "List active browser sessions for the authenticated subject",
        "security": [{ "bearerAuth": [] }, { "browserSession": [] }],
        "responses": {
          "200": {
            "description": "Bounded active-session inventory containing only public random identifiers and UTC timestamps",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/BrowserSessionListEnvelope" } }
            }
          },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "delete": {
        "operationId": "revokeAllOIDCBrowserSessions",
        "tags": ["auth"],
        "summary": "Revoke every active browser session for the authenticated subject",
        "security": [{ "bearerAuth": [] }, { "browserSession": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OptionalBrowserCSRFToken" }],
        "responses": {
          "204": {
            "description": "All browser sessions for the authenticated subject were revoked; any browser session and CSRF cookies are expired",
            "headers": {
              "Set-Cookie": {
                "description": "Expires the Secure __Host- session and CSRF cookies",
                "schema": { "type": "string" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/auth/oidc/sessions/{sessionId}": {
      "patch": {
        "operationId": "updateOIDCBrowserSessionDeviceName",
        "tags": ["auth"],
        "summary": "Set or clear the bounded device name for one subject-owned browser session",
        "security": [{ "bearerAuth": [] }, { "browserSession": [] }],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "Random public identifier returned by the session inventory",
            "schema": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$" }
          },
          { "$ref": "#/components/parameters/OptionalBrowserCSRFToken" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/BrowserSessionDeviceNameRequest" } }
          }
        },
        "responses": {
          "204": { "description": "The bounded device name was updated or cleared" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      },
      "delete": {
        "operationId": "revokeOIDCBrowserSession",
        "tags": ["auth"],
        "summary": "Revoke one subject-owned browser session by its public identifier",
        "security": [{ "bearerAuth": [] }, { "browserSession": [] }],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "description": "Random public identifier returned by the session inventory",
            "schema": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$" }
          },
          { "$ref": "#/components/parameters/OptionalBrowserCSRFToken" }
        ],
        "responses": {
          "204": { "description": "The subject-owned browser session was revoked" },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": ["auth"],
        "security": [{ "bearerAuth": [] }, { "browserSession": [] }],
        "responses": {
          "200": {
            "description": "Authenticated user",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" }
        }
      }
    },
    "/api/v1/example/hello": {
      "get": {
        "operationId": "getHello",
        "tags": ["example"],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Greeting",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          }
        }
      }
    },
    "/api/v1/example/echo": {
      "post": {
        "operationId": "postEcho",
        "tags": ["example"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Echoed object",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/example/validate": {
      "post": {
        "operationId": "validateProfile",
        "tags": ["example"],
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ProfileRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Validated profile",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/example/delay": {
      "get": {
        "operationId": "getDelayedResponse",
        "tags": ["example"],
        "parameters": [
          {
            "name": "ms",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 0, "maximum": 5000, "default": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Delay completed",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "408": { "$ref": "#/components/responses/RequestTimeout" }
        }
      }
    },
    "/api/v1/example/private": {
      "get": {
        "operationId": "getPrivateExample",
        "tags": ["example"],
        "security": [{ "bearerAuth": [] }, { "browserSession": [] }],
        "responses": {
          "200": {
            "description": "Private example response",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" }
        }
      }
    },
    "/api/v1/project": {
      "get": {
        "operationId": "getProjectInfo",
        "tags": ["project"],
        "responses": {
          "200": {
            "description": "Example project identity",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          }
        }
      }
    },
    "/api/v1/project/preview/{audience}": {
      "get": {
        "operationId": "previewProject",
        "tags": ["project"],
        "security": [{ "bearerAuth": [] }, { "browserSession": [] }],
        "x-required-roles": ["demo"],
        "x-resource-authorization": {
          "tenantSource": "header:X-Tenant-ID or principal:subject",
          "resourceType": "project",
          "resourceId": "current",
          "action": "preview"
        },
        "parameters": [
          {
            "name": "audience",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["summary", "detailed"]
            }
          },
          {
			"name": "X-Tenant-ID",
			"in": "header",
			"required": false,
			"description": "Optional tenant identifier; defaults to the authenticated subject and must match it under the current Example policy.",
			"schema": {
			  "type": "string",
			  "minLength": 1,
			  "maxLength": 128,
			  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:/|\\-]*$"
			}
		  },
		  {
            "name": "X-Client-Locale",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 16
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated project preview",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Envelope" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    },
    "/api/v1/project/describe": {
      "post": {
        "operationId": "describeProject",
        "tags": ["project"],
        "security": [{ "bearerAuth": [] }, { "browserSession": [] }],
        "x-required-roles": ["demo"],
        "x-resource-authorization": {
          "tenantSource": "body:tenantId or principal:subject",
          "resourceType": "project",
          "resourceId": "current",
          "action": "describe"
        },
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/OptionalBrowserCSRFToken" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ProjectDescriptionRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Typed project description",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Envelope" } }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/BearerUnauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT access token verified by the enabled demo token service or external OIDC/JWKS verifier. The login operation issues tokens only in demo mode."
      },
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-goexample-session",
        "description": "Opaque Secure HttpOnly application session established only by a verified browser OIDC callback. Unsafe methods also require X-CSRF-Token."
      },
      "internalBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dedicated token for internal diagnostics endpoints."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "X-Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Required as a 36-character key when idempotency middleware is enabled.",
        "schema": { "type": "string", "minLength": 36, "maxLength": 36 }
      },
      "BrowserCSRFToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "description": "Raw token from the bound __Host-goexample-csrf cookie.",
        "schema": { "type": "string", "minLength": 43, "maxLength": 43 }
      },
      "OptionalBrowserCSRFToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": false,
        "description": "Required only when this unsafe operation uses browserSession instead of bearerAuth.",
        "schema": { "type": "string", "minLength": 43, "maxLength": 43 }
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": ["code", "data", "msg"],
        "properties": {
          "code": { "type": "integer" },
          "data": true,
          "msg": { "type": "string" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["code", "data", "msg"],
        "properties": {
          "code": { "type": "integer", "minimum": 400, "maximum": 599 },
          "data": { "type": "null" },
          "msg": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "minLength": 3, "maxLength": 64 },
          "password": { "type": "string", "minLength": 6, "maxLength": 128 }
        }
      },
      "BrowserSessionInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "createdAt", "expiresAt"],
        "properties": {
          "sessionId": { "type": "string", "minLength": 43, "maxLength": 43, "pattern": "^[A-Za-z0-9_-]{43}$" },
          "createdAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "deviceName": { "type": "string", "maxLength": 64, "description": "Optional caller-supplied name; omitted when cleared" }
        }
      },
      "BrowserSessionDeviceNameRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["deviceName"],
        "properties": {
          "deviceName": { "type": "string", "maxLength": 64, "description": "Bounded caller-supplied name; an empty string clears it" }
        }
      },
      "BrowserSessionListEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "data", "msg"],
        "properties": {
          "code": { "type": "integer", "const": 0 },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/BrowserSessionInfo" }, "maxItems": 10000 },
          "msg": { "type": "string", "const": "success" }
        }
      },
      "ProfileRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "email", "age"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "email": { "type": "string", "format": "email", "maxLength": 254 },
          "age": { "type": "integer", "minimum": 18, "maximum": 130 }
        }
      },
      "ProjectDescriptionRequest": {
        "type": "object",
        "additionalProperties": false,
		"required": ["audience"],
        "properties": {
		  "tenantId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 128,
			"pattern": "^[A-Za-z0-9][A-Za-z0-9_.@:/|\\-]*$"
		  },
          "audience": { "type": "string", "minLength": 2, "maxLength": 80 }
        }
      }
    },
    "headers": {
      "Deprecation": {
        "description": "RFC 9745 deprecation date as a Structured Field Date.",
        "schema": { "type": "string", "const": "@1787184000" }
      },
