# Application
APP_NAME=GoExample API
APP_ENV=development

# Structured logging: debug|info|warn|error, json|text
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SKIP_PATHS=/livez,/readyz,/startupz,/metrics

# OpenTelemetry tracing. Export is disabled unless explicitly set to otlp.
# OTEL_EXPORTER_OTLP_ENDPOINT is a base HTTP(S) URL; /v1/traces is appended.
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
# Standard BatchSpanProcessor values are integer milliseconds/counts.
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=3001
HTTP_BODY_LIMIT=4194304
HTTP_READ_BUFFER_SIZE=16384
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_CONNECTIONS=4096
HTTP_REQUEST_TIMEOUT=8s
HTTP_MAX_IN_FLIGHT=256
HEALTH_CHECK_TIMEOUT=2s
HEALTH_CACHE_TTL=1s
SHUTDOWN_TIMEOUT=20s
# Keep lower than SHUTDOWN_TIMEOUT. Set to 3s-5s behind a slow load balancer.
SHUTDOWN_DRAIN_DELAY=0s

# Browser access and reverse proxies (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000
# Bearer-only APIs normally keep this false. Enable only for browser cookies/client certificates.
CORS_ALLOW_CREDENTIALS=false
# Use only explicit proxy IPs/CIDRs. Production rejects 0.0.0.0/0 and ::/0.
TRUSTED_PROXIES=

# API rate limits per client IP
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX=10

# Selected mutation routes replay successful X-Idempotency-Key requests.
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_LIFETIME=30m

# Shared limiter/idempotency state. Production defaults to external Redis and
# fails fast when the URL, startup ping, or atomic backend contract is unavailable.
SHARED_STATE_MODE=memory
ALLOW_IN_MEMORY_SHARED_STATE=false
# standalone (default) uses only REDIS_URL. sentinel requires REDIS_URL to stay
# empty and uses the discovery, ACL, database, and TLS fields below.
REDIS_TOPOLOGY=standalone
REDIS_URL=
REDIS_SENTINEL_ADDRESSES=
REDIS_SENTINEL_MASTER_NAME=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=
REDIS_DATABASE=0
REDIS_TLS_ENABLED=false
REDIS_TLS_SERVER_NAME=
REDIS_TLS_CA_FILE=
# Use a unique deployment/tenant prefix and keep the trailing colon.
REDIS_KEY_PREFIX=goexample:example:
REDIS_OPERATION_TIMEOUT=500ms
# The lease must exceed HTTP_REQUEST_TIMEOUT; wait/retry remain bounded.
REDIS_LOCK_TTL=15s
REDIS_LOCK_WAIT_TIMEOUT=2s
REDIS_LOCK_RETRY_INTERVAL=25ms
REDIS_POOL_SIZE=32
REDIS_MIN_IDLE_CONNECTIONS=2

# Internal endpoint protection. METRICS_TOKEN is required in production.
# Tokens must contain at least 32 characters. Metrics, enabled pprof, and an
# enabled demo JWT secret must all use different values in production.
METRICS_TOKEN=
PPROF_ENABLED=false
PPROF_TOKEN=
SYSTEM_INFO_DETAILED=true

# Demonstration JWT authentication. Replace secrets outside local development.
DEMO_AUTH_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
JWT_SECRET=goexample-development-jwt-secret-change-me
JWT_ISSUER=goexample
JWT_AUDIENCE=goexample-api
JWT_TTL=1h

# External RS256 OIDC/JWKS bearer verification. Mutually exclusive with demo
# auth. Browser Authorization Code + PKCE remains opt-in; successful callbacks
# establish an opaque server-side session without exposing provider tokens.
OIDC_AUTH_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=goexample-api
OIDC_JWKS_URL=
OIDC_JWKS_HTTP_TIMEOUT=3s
OIDC_JWKS_REFRESH_INTERVAL=5m
OIDC_MAX_TOKEN_AGE=15m
OIDC_BROWSER_ENABLED=false
# Optional browser-login assurance policy. A configured ACR must match exactly,
# every comma-separated AMR value must be present, and auth_time must be no
# older than the positive maximum age. Keep all three disabled together.
OIDC_REQUIRED_ACR=
OIDC_REQUIRED_AMR=
OIDC_MAX_AUTH_AGE=0s
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must be HTTPS and end exactly at /api/v1/auth/oidc/callback.
OIDC_REDIRECT_URL=
OIDC_AUTHORIZATION_TTL=5m
# Session expiry is also capped by the verified access token exp. Production
# stores hash-only session/CSRF credentials in the required external Redis
# backend and atomically limits each subject to the configured count.
OIDC_BROWSER_SESSION_TTL=15m
OIDC_BROWSER_MAX_SESSIONS=10000
OIDC_BROWSER_MAX_SESSIONS_PER_SUBJECT=10
