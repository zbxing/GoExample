# Application
APP_NAME=GoExample API
APP_ENV=development

# Structured logging: debug|info|warn|error, json|text
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SKIP_PATHS=/livez,/readyz,/startupz,/metrics

# OpenTelemetry tracing. Export is disabled unless explicitly set to otlp.
# OTEL_EXPORTER_OTLP_ENDPOINT is a base HTTP(S) URL; /v1/traces is appended.
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=0.1
# Standard BatchSpanProcessor values are integer milliseconds/counts.
OTEL_BSP_EXPORT_TIMEOUT=3000
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=3001
HTTP_BODY_LIMIT=4194304
HTTP_READ_BUFFER_SIZE=16384
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_CONNECTIONS=4096
HTTP_REQUEST_TIMEOUT=8s
HTTP_MAX_IN_FLIGHT=256
HEALTH_CHECK_TIMEOUT=2s
HEALTH_CACHE_TTL=1s
SHUTDOWN_TIMEOUT=20s
# Keep lower than SHUTDOWN_TIMEOUT. Set to 3s-5s behind a slow load balancer.
SHUTDOWN_DRAIN_DELAY=0s

# Browser access and reverse proxies (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000
# Bearer-only APIs normally keep this false. Enable only for browser cookies/client certificates.
CORS_ALLOW_CREDENTIALS=false
# Use only explicit proxy IPs/CIDRs. Production rejects 0.0.0.0/0 and ::/0.
TRUSTED_PROXIES=

# API rate limits per client IP
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX=10

# Selected mutation routes replay successful X-Idempotency-Key requests from process memory.
IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_LIFETIME=30m

# Shared limiter/idempotency state. Production defaults to external and fails fast
# until the application injects a shared Storage and distributed Locker.
SHARED_STATE_MODE=memory
ALLOW_IN_MEMORY_SHARED_STATE=false

# Internal endpoint protection. METRICS_TOKEN is required in production.
# Tokens must contain at least 32 characters. Production JWT, metrics, and
# enabled pprof secrets must all be different values.
METRICS_TOKEN=
PPROF_ENABLED=false
PPROF_TOKEN=
SYSTEM_INFO_DETAILED=true

# Demonstration JWT authentication. Replace secrets outside local development.
DEMO_AUTH_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
JWT_SECRET=goexample-development-jwt-secret-change-me
JWT_ISSUER=goexample
JWT_AUDIENCE=goexample-api
JWT_TTL=1h
